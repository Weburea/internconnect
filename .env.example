APP_NAME=InternConnect
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CLOUDINARY_CLOUD_NAME=



# ==============================================================================
# SYSTEMATIC SEO & METADATA CONFIGURATION
# ==============================================================================
SEO_SITE_NAME="InternConnect"
SEO_SITE_TITLE_DEFAULT="InternConnect — AI Internship & Early-Career Platform"
SEO_DESCRIPTION_DEFAULT="Find verified internships and graduate roles worldwide. Jenny AI matches your skills, polishes your CV and helps you prepare, while employers hire ready-to-work interns."
SEO_KEYWORDS_DEFAULT="internships in nigeria, student internships lagos, SIWES placement, NYSC jobs, tech internships abuja, remote internships nigeria, internconnect"
SEO_CANONICAL_BASE_URL="http://localhost/InternConnect"
SEO_DEFAULT_OG_IMAGE="https://res.cloudinary.com/weburea/image/upload/v1785517512/Logo_single_dark_dj6vhf.png"
SEO_TWITTER_HANDLE="@InternConnectNG"
SEO_TWITTER_CARD="summary_large_image"
SEO_LOCALE="en_NG"
SEO_GEO_REGION="NG-LA"
SEO_GEO_PLACENAME="Lagos, Nigeria"
SEO_GEO_POSITION="6.5244;3.3792"
SEO_ICBM="6.5244, 3.3792"
SEO_ROBOTS_DEFAULT="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
SEO_GOOGLE_SITE_VERIFICATION=""
SEO_BING_SITE_VERIFICATION=""

# ==============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# ==============================================================================
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_PROJECT_NAME="projects/your-project-id"
GEMINI_PROJECT_NUMBER="your-project-number"
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_FALLBACK_MODEL="gemini-flash-latest"
AI_PROVIDER="gemini"
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2


# ==============================================================================
# MAXMIND GEOLITE2 (LIVE VISITOR LOCATIONS ON THE ADMIN OVERVIEW MAP)
# ==============================================================================
# Free account: https://www.maxmind.com/en/geolite2/signup
# Find both values under Account > Manage License Keys.
# Keep these out of git and chat. Add the same lines to the cPanel .env on deploy.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ==============================================================================
# DAILY.CO IN-PLATFORM VIDEO INTERVIEW CONFIGURATION
# ==============================================================================
# Get it at https://dashboard.daily.co > Developers. Server-side only: never expose it in JS.
# Rooms and per-participant tokens are created automatically (docs/47-video-interviews.md).
DAILY_API_KEY=
DAILY_DOMAIN="internconnect"

# API v1 (docs/51-api-and-security.md)
JWT_SECRET="generate-64-random-hex-characters"
API_DEMO_PASSWORD="choose-a-strong-password"
API_CORS_ORIGINS=""

# Mail (SMTP over SSL). MAIL_PASSWORD only in .env, never in git.
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=InternConnect
MAIL_REPLY_TO=
MAIL_ADMIN_ADDRESS=
