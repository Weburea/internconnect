{
    "name": "weburea/internconnect",
    "description": "InternConnect: AI-powered internship platform (Pure PHP Version)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "spatie/schema-org": "^4.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:feature": "phpunit --testsuite Feature",
        "test:legacy": "php tests/run_tests.php"
    }
}
